{
  "name": "folder-chinese",
  "description": "文件夹设置工具 - 中文别名、自定义图标、备注提示，保留英文底层路径",
  "version": "2.0.0",
  "author": "xiaoxiao",
  "logo": "logo.png",
  "main": "index.html",
  "preload": "preload.js",
  "development": {
    "main": "http://127.0.0.1:5177/index.html"
  },
  "features": [
    {
      "code": "folder-chinese",
      "icon": "icon/logo.png",
      "explain": "为当前文件夹设置中文别名、图标、备注",
      "cmds": [
        "文件夹别名",
        "文件夹设置"
      ]
    },
    {
      "code": "folder-chinese-batch",
      "icon": "icon/logo.png",
      "explain": "批量设置文件夹中文别名",
      "cmds": [
        {
          "type": "files",
          "label": "文件夹设置",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 100
        }
      ]
    },
    {
      "code": "folder-settings",
      "icon": "icon/logo.png",
      "explain": "管理已设置过的文件夹（历史记录）",
      "cmds": [
        "文件夹历史",
        "文件夹管理"
      ]
    },
    {
      "code": "folder-merge-to-new",
      "icon": "icon/logo_1.png",
      "explain": "将选中的文件或文件夹放入新建文件夹",
      "mainHide": true,
      "cmds": [
        {
          "type": "files",
          "label": "放入新建文件夹",
          "minLength": 1,
          "maxLength": 100
        }
      ]
    },
    {
      "code": "folder-dissolve",
      "icon": "icon/logo_2.png",
      "explain": "将选中文件夹内的项目解散到上一级目录",
      "mainHide": true,
      "cmds": [
        {
          "type": "files",
          "label": "解散文件夹",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 100
        }
      ]
    }
  ]
}
