{
  "name": "folder-chinese",
  "description": "文件夹设置工具 - 中文别名、自定义图标、备注提示，保留英文底层路径",
  "version": "2.0.0",
  "author": "xiaoxiao",
  "logo": "logo.png",
  "main": "index.html",
  "preload": "preload.js",
  "pluginSetting": {
    "height": 600
  },
  "features": [
    {
      "code": "folder-chinese",
      "explain": "为当前文件夹设置中文别名、图标、备注",
      "cmds": [
        "文件夹别名",
        "文件夹设置"
      ]
    },
    {
      "code": "folder-chinese-batch",
      "explain": "批量设置文件夹中文别名",
      "cmds": [
        {
          "type": "files",
          "label": "文件夹设置",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 100
        }
      ]
    },
    {
      "code": "folder-settings",
      "explain": "管理已设置过的文件夹（历史记录）",
      "cmds": [
        "文件夹历史",
        "文件夹管理"
      ]
    }
  ]
}
